# TEMPLATE FILE ONLY
# Copy this file to `.env` and fill in values.
# `.env` is used at runtime.
# `.env.example` is NOT used by the application.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_GALLERY_BUCKET=gallery
SUPABASE_SERVICE_ROLE_KEY=

# Required for admin portal access in production. Comma-separate allowed Supabase Auth emails.
ADMIN_EMAILS=
# Local/testing-only; never enable in production.
ALLOW_ADMIN_AUTH_BYPASS=false

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
BRITTNEY_NOTIFICATION_PHONE=

RESEND_API_KEY=
# Required in production. Must be a Resend-verified sender/domain.
RESEND_FROM_EMAIL=
BOOKING_PUBLIC_BASE_URL=https://nailsbybrittney.com

# Square production configuration.
SQUARE_APPLICATION_ID=
SQUARE_LOCATION_ID=
SQUARE_ACCESS_TOKEN=
SQUARE_API_BASE_URL=https://connect.squareup.com
SQUARE_API_VERSION=2025-10-16
SQUARE_CURRENCY=USD
VITE_SQUARE_APPLICATION_ID=
VITE_SQUARE_LOCATION_ID=
VITE_SQUARE_ENVIRONMENT=production
VITE_ENABLE_SQUARE_DEV_TOKEN_INPUT=false

# Local/testing-only Square values. Do not use these in production.
# SQUARE_API_BASE_URL=https://connect.squareupsandbox.com
# VITE_SQUARE_ENVIRONMENT=sandbox
# SQUARE_ALLOW_MOCK=true
SQUARE_ALLOW_MOCK=false
